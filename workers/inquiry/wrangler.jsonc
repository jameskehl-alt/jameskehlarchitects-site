// Inquiry form handler for jameskehlarchitects.com/api/inquiry (Workers free plan).
// It relays each inquiry to the Apps Script web app "JKA website inquiries" in James's Google account
// (james.kehl@gmail.com), which emails it to james@jameskehlarchitects.com. The route sits in front of the
// site's custom domain for this one path. Secrets (set in the dashboard or with `wrangler secret put`):
//   SCRIPT_URL   the web app's /exec URL
//   RELAY_TOKEN  the token in the script
{
  "name": "jka-inquiry",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "jameskehlarchitects.com/api/inquiry", "zone_name": "jameskehlarchitects.com" }],
  "observability": { "enabled": true }
}
